# Apache config for Next.js static export (noblelift.cz)
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Legacy /cs → /cz
  RewriteRule ^cs/?$ /cz/ [R=308,L]
  RewriteRule ^cs/(.*)$ /cz/$1 [R=308,L]

  # Fallback: old CZ export path /cz/products → /cz/produkty
  RewriteRule ^cz/products/?$ /cz/produkty/ [R=301,L]
  RewriteRule ^cz/products/(.*)$ /cz/produkty/$1 [R=301,L]

  # Root → default locale
  RewriteRule ^$ /cz/ [R=302,L]

  # Existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Trailing slash HTML (next export with trailingSlash: true)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/ [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json|svg|woff2?)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|ico|pdf)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>
